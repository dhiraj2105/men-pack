{
  "name": "men-pack",
  "version": "3.0.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhiraj2105/men-pack"
  },
  "main": "dist/cli/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src tests scripts docs/site/site.js",
    "test": "npm run build && npm run docs:build && node --test tests/*.test.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "bin": {
    "men-pack": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "llms.txt"
  ],
  "keywords": [
    "men-pack",
    "scaffolding",
    "backend",
    "javascript",
    "typescript",
    "express",
    "fastify",
    "nestjs",
    "mongodb",
    "postgresql",
    "sqlite",
    "node",
    "dhiraj kumar"
  ],
  "author": "Dhiraj Kumar",
  "license": "ISC",
  "description": "Scaffold production-ready Node.js APIs with Express, Fastify, or NestJS",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "marked": "^18.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "inquirer": "^12.2.0"
  }
}
